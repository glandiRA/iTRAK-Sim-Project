<?xml version="1.0" encoding="utf-8"?>
<Routine Name="TargetPosition" Type="RLL">
  <Description>
    <LocalizedDescription Lang="en-US"><![CDATA[Load Target Initial Position and Switches On Q_mam Command Bits]]></LocalizedDescription>
  </Description>
  <RLLContent>
    <Rung Type="N">
      <Text><![CDATA[MOVE(QPos,QMam_Parameters[TargetPosIndex].rTargetPos);]]></Text>
    </Rung>
    <Rung Type="N">
      <Text><![CDATA[OTL(QMam_Cmd[TargetPosIndex]);]]></Text>
    </Rung>
  </RLLContent>
</Routine>